# Supabase Configuration
# Current Supabase API Key Model (Project Settings -> API Keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# PostgreSQL Database Connection String
# Obtain from Supabase Project Settings -> Database -> Connection string (URI)
DATABASE_URL=

# Rate Limiting & Ephemeral Cache (Redis / Upstash)
# Optional in local development (falls back to local rate limiter with warning).
# For production: Upstash Redis REST credentials or direct Redis URL
REDIS_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Error Tracking (Optional)
SENTRY_DSN=

# Official NSUT Verification Integration Boundary
# Provided by NSUT IT / Institutional Verification Authority
# If not configured, verification will fail gracefully with an explicit configuration error.
NSUT_VERIFICATION_URL=
NSUT_VERIFICATION_CLIENT_ID=
NSUT_VERIFICATION_CLIENT_SECRET=
